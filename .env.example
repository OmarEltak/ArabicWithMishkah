APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Independent key for the audit-log HMAC chain. Generate with:
#   php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# MUST be set in production — falls back to APP_KEY otherwise, which weakens
# isolation between audit-chain integrity and the general encryption layer.
APP_AUDIT_KEY=

# Required for the /__internal/health endpoint. Callers must send this value
# in the X-Internal-Health-Key header. Generate with:
#   php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Leave empty in dev to disable the endpoint entirely (always 403).
APP_INTERNAL_HEALTH_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── External error alerting ───────────────────────────────────────────
# The `errors` log channel is a stack — by default it writes to
# storage/logs/errors.log only. Fan out to Slack and/or Sentry by listing
# the channels here (comma-separated, no spaces).
#
# Examples:
#   LOG_ERRORS_STACK=errors_file,slack
#   LOG_ERRORS_STACK=errors_file,sentry
#   LOG_ERRORS_STACK=errors_file,slack,sentry
LOG_ERRORS_STACK=errors_file

# Slack (zero-deps option). Create an Incoming Webhook at
# https://api.slack.com/apps and paste the URL here.
# LOG_SLACK_WEBHOOK_URL=

# Sentry (richer alerting). Install with:
#   composer require sentry/sentry-laravel
#   php artisan sentry:publish --dsn=YOUR_DSN
# Then set:
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# To switch to Postgres + pgvector for production-scale RAG:
#   1. Install pgvector extension on your Postgres server (CREATE EXTENSION vector;)
#   2. Set:
#        DB_CONNECTION=pgsql
#        DB_HOST=127.0.0.1
#        DB_PORT=5432
#        DB_DATABASE=my_lawyer
#        DB_USERNAME=...
#        DB_PASSWORD=...
#   3. php artisan migrate
#   4. php artisan rag:promote-to-pgvector  (backfills JSON → vector column)

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true in production — session payloads in the DB are otherwise plaintext.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (HTTPS-only cookie). Local HTTP dev: false.
# Default in config/session.php is "true unless APP_ENV=local".
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI / RAG configuration
# LLM_PROVIDER picks which chat backend ContractDraftingService uses:
#   anthropic — Claude (best quality for legal Arabic; pay-as-you-go billing)
#   groq      — Llama 3.3 70B / similar via Groq's OpenAI-compatible API (fast, free tier)
#   gemini    — Google Gemini 2.0/2.5 Flash (free tier 1500 RPD per key; pool below)
LLM_PROVIDER=anthropic
# When true (default), LlmFactory wraps the primary provider in a failover
# chain. If all keys in the primary's pool 429/403, the request falls
# through to the next configured provider. Set false to disable for A/B
# testing or when comparing specific provider behaviour.
LAWYER_LLM_FALLBACK=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Groq key pool — 429 from one rotates to the next (sticky for 5 min)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini key pool — same rotation pattern. Free tier = 1500 requests/day per
# key, so 3 keys give a soft 4500 RPD ceiling for the demo.
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.0-flash

# EMBEDDING_PROVIDER picks the vector embedder:
#   voyage — Voyage AI (production default; ~$0.06 / 1M tokens)
#   openai — OpenAI text-embedding-3-small
#   mock   — deterministic SHA-derived 256-d vectors (no API key needed; not semantic)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Eastlaws ingestion (optional). Only enable with permission/credentials.
EASTLAWS_BASE_URL=https://www.eastlaws.com
EASTLAWS_USERNAME=
EASTLAWS_PASSWORD=
EASTLAWS_ENABLED=false

# RAG tuning
LAWYER_CHUNK_SIZE=900
LAWYER_CHUNK_OVERLAP=120
LAWYER_TOP_K=6

# Cost controls (USD per day). Hard caps enforced before every AI call.
LAWYER_DAILY_BUDGET_USD=50
LAWYER_PER_USER_DAILY_BUDGET_USD=5

# ─── Stripe / Cashier billing ──────────────────────────────────────────
#
# Test-mode keys live in dashboard.stripe.com → Developers → API keys.
# Live keys ship only when you go to production; keep test in dev/staging.
#
STRIPE_KEY=
STRIPE_SECRET=
#
# Webhook secret: create the endpoint pointing to https://<domain>/billing/webhook
# in dashboard.stripe.com → Developers → Webhooks, then copy the "Signing secret"
# (whsec_...) here. Cashier verifies every incoming event against it.
STRIPE_WEBHOOK_SECRET=
#
# Price IDs — create one product per plan in Stripe with two prices
# (monthly + yearly). Format: price_xxxxx. Solo and Firm are the two
# paid plans; free and enterprise have null price IDs in config/lawyer.php
# (free is the default, enterprise is contact-sales).
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_FIRM_MONTHLY=
STRIPE_PRICE_FIRM_YEARLY=
#
# Trial period for paid plans (days). 0 disables the trial.
LAWYER_TRIAL_DAYS=14
#
# Stripe-side display currency. Should match the currency you created
# the prices in. EGP / USD / SAR / AED are common.
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en
